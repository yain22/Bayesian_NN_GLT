<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Follow the Gaussian variational fitting algorithm for G, GL and GLT neural networks, with equations, R controls and linked implementation."><title>@@TITLE@@ · gltbnn</title>
<style>@@CSS@@
[hidden]{display:none!important}button,input,summary{font:inherit}button,summary{cursor:pointer}summary{font-weight:650}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible,.equation:focus-visible{outline:3px solid #ae632c;outline-offset:3px}.bar-inner{gap:1.4rem}.walk{padding:clamp(2.2rem,5vw,4.25rem) 0 3rem}.walk h1{font-size:clamp(2.5rem,5.2vw,4.1rem);max-width:22ch}.walk .intro{max-width:82ch;margin:1.1rem 0 1.6rem}.selectors,.paging,.budget-actions,.budget-fields{display:flex;align-items:center;flex-wrap:wrap;gap:.6rem}.switch{border:1px solid #7c9499;background:transparent;border-radius:5px;padding:.45rem 1.18rem;font-weight:650;text-decoration:none;font-size:1rem}.switch[aria-current=true]{background:var(--navy);color:white;border-color:var(--navy)}.model{margin-top:1.6rem}.model-head{border-top:1px solid var(--rule);padding:1.35rem 0 1.2rem}.model-head h2{font-size:clamp(1.65rem,3.6vw,2.5rem)}.model-head p{margin:.25rem 0;max-width:78ch;color:var(--muted)}.layout{display:grid;grid-template-columns:minmax(13rem,16.5rem) minmax(0,1fr);gap:clamp(1.5rem,4vw,3.2rem);align-items:start}.step-index{border:1px solid var(--rule);border-radius:5px;padding:.8rem 1rem;background:#f3f2eb}.step-index summary,.notes summary,.budget>summary{color:var(--navy)}.step-index ol{margin:.6rem 0 .1rem;padding:0;list-style:none;counter-reset:steps}.step-index li{counter-increment:steps;position:relative;margin:.08rem 0}.step-link{display:grid;align-items:baseline;grid-template-columns:1.2rem 1fr;gap:.35rem;color:var(--muted);font-size:.9rem;line-height:1.32;text-decoration:none;border-left:3px solid transparent;padding:.45rem .35rem}.step-link::before{content:counter(steps);font-size:.78rem;font-variant-numeric:tabular-nums;color:var(--muted)}.step-link[aria-current=step]{border-left-color:var(--rust);background:#e7e9e2;color:var(--ink);font-weight:650}.step-link:hover{text-decoration:underline}.reading{min-width:0}.step{scroll-margin-top:1rem;padding-top:.35rem;padding-bottom:.7rem;border-bottom:1px solid var(--rule)}.step+.step{margin-top:1.5rem}.eyebrow,.location{font-size:.8rem;font-weight:650;color:var(--rust);letter-spacing:.025em;margin:0 0 .35rem}.step h3{font-size:clamp(1.9rem,4vw,2.8rem);display:block;line-height:1.1;outline-offset:.4rem}.step p{max-width:76ch;margin:.8rem 0}.step .lead{color:var(--muted);font-size:1.05rem}.equation{max-width:100%;overflow-x:auto;padding:.42rem .5rem;margin:.6rem 0;background:#eef0ea;border-left:2px solid #aebeb8}.step math[display=block]{margin:.35rem 0;font-size:1.06rem}.step pre,.budget pre{background:#edf0ec;color:#183447;border-radius:4px;margin:.6rem 0}.notes{border-top:1px solid var(--rule);padding:.65rem 0;margin-top:.55rem}.notes summary{font-size:.92rem}.notes>p,.notes>ul{margin:.6rem 0}.refs ul{padding-left:1.25rem}.paging{justify-content:space-between;margin-top:1rem}.paging button,.budget-actions button{border:1px solid #819698;background:#fffdfa;color:var(--navy);border-radius:4px;padding:.48rem .83rem;font-weight:600}.paging button:disabled{opacity:.45;cursor:default}.permalink{font-size:.85rem;margin-inline:auto}.budget{border-top:1px solid var(--rule);margin:1.8rem 0 1rem;padding:1.1rem 0}.budget>summary{font:600 1.38rem var(--serif)}.budget p{max-width:72ch}.budget-fields{align-items:end;gap:.75rem 1.75rem}.budget-fields label{display:grid;font-size:.9rem;font-weight:650;gap:.15rem}.budget-fields input{width:8rem;color:var(--ink);background:#fffdfa;border:1px solid #809399;padding:.38rem .5rem;border-radius:3px}.budget-fields input[aria-invalid=true]{border:2px solid var(--rust)}.counts{color:var(--ink);font-weight:600}.feedback{color:var(--rust);margin:.35rem 0}.budget-actions{font-size:.9rem}.budget-actions output{color:var(--muted)}.menu-label{font-size:.88rem;color:var(--muted);font-weight:650;margin:0 .4rem 0 0}.walk footer{border:0}.skip:focus{z-index:3}.step .notes pre{max-width:100%}.step a,.model-head p,.step p{overflow-wrap:anywhere}.step math{overflow-wrap:normal}mtd[columnalign="left"]{text-align:left}mtd[columnalign="right"]{text-align:right}
@media(max-width:740px){.layout{grid-template-columns:minmax(0,1fr);gap:1rem}.step-index{padding:.6rem .8rem}.walk{padding-top:1.65rem}.bar-inner nav{gap:.55rem 1rem;justify-content:flex-start}.step h3{font-size:1.8rem}.walk .intro{margin-bottom:1.1rem}.paging{gap:.35rem}.paging button{font-size:.88rem}.step .equation{padding:.35rem}.model-head{padding:1rem 0 .75rem}.permalink{margin-inline:0}}@media print{.topbar,.selectors,.paging,.step-index,.budget-actions,.skip{display:none!important}.model,.step{display:block!important}.layout{display:block}.walk,.wrap{width:100%;margin:0;padding:0}.equation{break-inside:avoid;overflow:visible}.step{break-before:auto}.budget{display:none}}
</style></head><body><a class="skip" href="#content">Skip to algorithms</a><header class="topbar"><div class="wrap bar-inner"><a class="wordmark" href="../">glt<span>bnn</span></a><nav aria-label="Computation"><a href="index.html">R fitting guide</a><a href="elbo-replay.html">ELBO replay</a><a href="#budget">Fitting budget</a></nav></div></header>
<main class="wrap walk" id="content"><h1>@@TITLE@@</h1><p class="intro">@@INTRO@@ <a href="cycle.html">Trace one coefficient through an update</a> in a network fitted to the timber-volume data.</p><div class="selectors" role="group" aria-label="Select a shrinkage prior"><span class="menu-label">Prior</span><a href="#g" class="switch" data-select="G">G</a><a href="#gl" class="switch" data-select="GL">GL</a><a href="#glt" class="switch" data-select="GLT">GLT</a></div>
@@MODELS@@
<details class="budget" id="budget"><summary>Fitting budget in R</summary><p>Set the budget for one Gaussian-response fit. The counts below follow from your controls. The calculator does not run the R fitter or change any recorded trajectories.</p><div class="budget-fields"><label>Cycles <code>outer</code><input id="outer" type="number" min="1" max="2147483647" step="1" value="60" required></label><label>Weight attempts per cycle <code>weight_steps</code><input id="weight_steps" type="number" min="1" max="2147483647" step="1" value="10" required></label><label>Warm-start steps <code>init_steps</code><input id="init_steps" type="number" min="1" max="2147483647" step="1" value="600" required></label></div><p class="feedback" id="error" aria-live="polite"></p><p class="counts" id="counts" aria-live="polite">600 warm-start steps · 600 variational weight-update attempts · 61 full-batch ELBO checkpoints (cycle 0 through 60).</p><pre tabindex="0"><code id="call">gltbnn_fit(x, y, prior = "G",
           control = list(outer = 60L, weight_steps = 10L,
                          init_steps = 600L))</code></pre><div class="budget-actions" hidden><button type="button" id="copy">Copy R call</button><button type="button" id="reset">Reset budget</button><output id="copy-status" aria-live="polite"></output></div><noscript><p>Enable JavaScript to change the controls or select and copy the default call above.</p></noscript></details></main>
<script>
(()=>{
  const models=Array.from(document.querySelectorAll('.model'));
  const selectors=Array.from(document.querySelectorAll('.switch'));
  const fields=Array.from(document.querySelectorAll('.budget-fields input'));
  const budget=document.getElementById('budget');
  const code=document.getElementById('call');
  const copy=document.getElementById('copy');
  const notice=document.getElementById('copy-status');
  const compact=window.matchMedia('(max-width:740px)');
  let active=models[0], index=0;
  const steps=model=>Array.from(model.querySelectorAll('article.step'));
  function count(){
    notice.textContent='';
    const invalid=fields.filter(f=>!/^\d+$/.test(f.value)||!f.validity.valid);
    for(const f of fields)f.setAttribute('aria-invalid',String(invalid.includes(f)));
    document.getElementById('error').textContent=invalid.length?'Enter a positive whole number up to 2,147,483,647 for each control.':'';
    copy.disabled=Boolean(invalid.length);
    if(invalid.length){code.textContent='';document.getElementById('counts').textContent='';return;}
    const [outer,weights,init]=fields.map(f=>BigInt(f.value));
    const fmt=v=>v.toLocaleString('en-US');
    document.getElementById('counts').textContent=`${fmt(init)} warm-start steps · ${fmt(outer*weights)} variational weight-update attempts · ${fmt(outer+1n)} full-batch ELBO checkpoints (cycle 0 through ${fmt(outer)}).`;
    code.textContent=`gltbnn_fit(x, y, prior = "${active.dataset.prior}",\n           control = list(outer = ${outer}L, weight_steps = ${weights}L,\n                          init_steps = ${init}L))`;
  }
  function display(model,number,moveFocus=false){
    const articles=steps(model);
    if(number<0||number>=articles.length)return;
    active=model;index=number;
    models.forEach(m=>{m.hidden=m!==model});
    for(const a of selectors){const on=a.dataset.select===model.dataset.prior;if(on)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current');}
    articles.forEach((article,i)=>{article.hidden=i!==index});
    model.querySelectorAll('.step-link').forEach((link,i)=>{if(i===index)link.setAttribute('aria-current','step');else link.removeAttribute('aria-current')});
    const paging=model.querySelector('.paging');paging.hidden=false;
    paging.querySelector('[data-move="-1"]').disabled=index===0;
    paging.querySelector('[data-move="1"]').disabled=index===articles.length-1;
    paging.querySelector('.permalink').href='#'+articles[index].id;
    count();
    if(moveFocus){if(compact.matches)model.querySelector('.step-index').open=false;articles[index].querySelector('h3').focus({preventScroll:true});const rect=articles[index].getBoundingClientRect();if(rect.top<24||rect.top>innerHeight*.65)articles[index].scrollIntoView({block:'start'});}
  }
  function navigate(model,i,focus){const hash='#'+steps(model)[i].id;if(location.hash!==hash)history.pushState(null,'',hash);display(model,i,focus);}
  function fromHash(){
    const target=document.getElementById(location.hash.slice(1));
    if(target===budget){budget.open=true;return;}
    if(target?.matches('article.step')){const model=target.closest('.model');display(model,steps(model).indexOf(target));return;}
    if(target?.matches('.model')){display(target,0);return;}
    display(models[0],0);
  }
  for(const model of models){model.querySelector('.step-index').open=!compact.matches;
    model.querySelectorAll('.step-link').forEach((link,i)=>link.addEventListener('click',e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();navigate(model,i,true)}));
    model.querySelectorAll('[data-move]').forEach(btn=>btn.addEventListener('click',()=>navigate(model,index+Number(btn.dataset.move),true)));
  }
  selectors.forEach(a=>a.addEventListener('click',e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();const model=models.find(m=>m.dataset.prior===a.dataset.select);const key=steps(active)[index].dataset.key;const i=steps(model).findIndex(s=>s.dataset.key===key);navigate(model,Math.max(0,i),false)}));
  fields.forEach(f=>f.addEventListener('input',count));
  document.getElementById('reset').addEventListener('click',()=>{fields.forEach(f=>f.value=f.defaultValue);count()});
  copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(code.textContent);notice.textContent='R call copied.'}catch{const r=document.createRange();r.selectNodeContents(code);const s=getSelection();s.removeAllRanges();s.addRange(r);notice.textContent=document.execCommand('copy')?'R call copied.':'R call selected. Use your keyboard to copy.'}});
  document.querySelector('.budget-actions').hidden=false;
  document.querySelector('a[href="#budget"]').addEventListener('click',()=>budget.open=true);
  window.addEventListener('hashchange',fromHash);window.addEventListener('popstate',fromHash);
  compact.addEventListener('change',()=>models.forEach(m=>m.querySelector('.step-index').open=!compact.matches));
  display(models[0],0);fromHash();
})();
</script></body></html>
